@page "/"
@inject NexStarService NexStar
@inject BlazorJSRuntime JS
@implements IDisposable

<PageTitle>NexStar Telescope Control</PageTitle>

<div class="telescope-app">
    <!-- Header -->
    <header class="app-header">
        <h1>🔭 NexStar Telescope Control</h1>
        <div class="connection-status">
            @if (NexStar.ComsEnabled)
            {
                <span class="status connected">Connected</span>
                <span class="model-info">@NexStar.Model.GetDisplayName() @NexStar.Version</span>
            }
            else if (NexStar.SerialPortSelected)
            {
                <span class="status ready">Ready</span>
            }
            else
            {
                <span class="status disconnected">Disconnected</span>
            }
        </div>
    </header>

    <main class="app-main">
        <!-- Connection Panel -->
        <section class="panel connection-panel">
            <h2>Connection</h2>
            <div class="button-row">
                @if (!NexStar.SerialPortSelected)
                {
                    <button class="btn btn-primary" @onclick="SelectPort" disabled="@_isLoading">
                        <span class="icon">🔌</span> Select Port
                    </button>
                }
                else if (!NexStar.ComsEnabled)
                {
                    <button class="btn btn-success" @onclick="Connect" disabled="@_isLoading">
                        <span class="icon">▶</span> Connect
                    </button>
                    <button class="btn btn-secondary" @onclick="DeselectPort" disabled="@_isLoading">
                        <span class="icon">✕</span> Change Port
                    </button>
                }
                else
                {
                    <button class="btn btn-danger" @onclick="Disconnect" disabled="@_isLoading">
                        <span class="icon">■</span> Disconnect
                    </button>
                    <button class="btn btn-secondary" @onclick="RefreshInfo" disabled="@_isLoading">
                        <span class="icon">↻</span> Refresh
                    </button>
                }
            </div>
            <div class="info-grid @(!NexStar.ComsEnabled ? "disabled-section" : "")">
                <div class="info-item">
                    <label>Alignment</label>
                    <span class="@(NexStar.IsAligned ? "status-good" : "status-warn")">
                        @(NexStar.ComsEnabled ? (NexStar.IsAligned ? "✓ Aligned" : "⚠ Not Aligned") : "—")
                    </span>
                </div>
                <div class="info-item">
                    <label>Tracking</label>
                    <span>@(NexStar.ComsEnabled ? NexStar.CurrentTrackingMode.ToString() : "—")</span>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <div class="status-message @_statusClass">@_statusMessage</div>
            }
        </section>

        <!-- Position Display -->
        <section class="panel position-panel @(!NexStar.ComsEnabled ? "disabled-panel" : "")">
                <h2>Position</h2>
                <div class="position-grid">
                    <div class="position-card">
                        <h3>Equatorial (RA/Dec)</h3>
                        @if (NexStar.CurrentRaDec != null)
                        {
                            <div class="coord-row">
                                <label>RA:</label>
                                <span class="coord-value">@NexStar.CurrentRaDec.FormatRA()</span>
                            </div>
                            <div class="coord-row">
                                <label>Dec:</label>
                                <span class="coord-value">@NexStar.CurrentRaDec.FormatDec()</span>
                            </div>
                        }
                        else
                        {
                            <p class="no-data">No data</p>
                        }
                    </div>
                    <div class="position-card">
                        <h3>Horizontal (Az/Alt)</h3>
                        @if (NexStar.CurrentAzAlt != null)
                        {
                            <div class="coord-row">
                                <label>Az:</label>
                                <span class="coord-value">@NexStar.CurrentAzAlt.FormatAz()</span>
                            </div>
                            <div class="coord-row">
                                <label>Alt:</label>
                                <span class="coord-value">@NexStar.CurrentAzAlt.FormatAlt()</span>
                            </div>
                        }
                        else
                        {
                            <p class="no-data">No data</p>
                        }
                    </div>
                </div>
                <div class="button-row">
                    <button class="btn btn-sm" @onclick="UpdatePosition" disabled="@(_isLoading || !NexStar.ComsEnabled)">
                        ↻ Update Position
                    </button>
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="_autoUpdatePosition" disabled="@(!NexStar.ComsEnabled)" />
                        Auto-update
                    </label>
                </div>
            </section>

        <!-- Quick Access -->
        <section class="panel quick-access-panel @(!NexStar.ComsEnabled ? "disabled-panel" : "")">
                <h2>🎯 Quick Access</h2>
                <div class="quick-targets">
                    @foreach (var target in GetQuickTargets())
                    {
                        <button class="quick-btn" @onclick="@(() => QuickGoto(target))" 
                                disabled="@(!NexStar.ComsEnabled)">
                            @target.DisplayName
                        </button>
                    }
                </div>
                <div class="quick-links">
                    <a href="objects" class="link-btn">🌌 Object Browser</a>
                    <a href="alignment" class="link-btn">⭐ Alignment Helper</a>
                </div>
            </section>

        <!-- Manual Slew Controls -->
        <section class="panel slew-panel @(!NexStar.ComsEnabled ? "disabled-panel" : "")">
                <h2>Manual Slew</h2>
                <div class="slew-controls">
                    <div class="dpad">
                        <button type="button" class="dpad-btn north" 
                                @onclick="@(async () => await SlewNorth())"
                                disabled="@(!NexStar.ComsEnabled)">
                            ▲<br/>N
                        </button>
                        <button type="button" class="dpad-btn west"
                                @onclick="@(async () => await SlewWest())"
                                disabled="@(!NexStar.ComsEnabled)">
                            ◀ W
                        </button>
                        <button type="button" class="dpad-btn stop" @onclick="StopAll" disabled="@(!NexStar.ComsEnabled)">■</button>
                        <button type="button" class="dpad-btn east"
                                @onclick="@(async () => await SlewEast())"
                                disabled="@(!NexStar.ComsEnabled)">
                            E ▶
                        </button>
                        <button type="button" class="dpad-btn south"
                                @onclick="@(async () => await SlewSouth())"
                                disabled="@(!NexStar.ComsEnabled)">
                            S<br/>▼
                        </button>
                    </div>
                    <div class="slew-rate-control">
                        <label>Slew Rate: @_slewRate</label>
                        <input type="range" min="1" max="9" @bind="_slewRate" @bind:event="oninput" disabled="@(!NexStar.ComsEnabled)" />
                        <div class="rate-labels">
                            <span>Slow</span>
                            <span>Fast</span>
                        </div>
                    </div>
                </div>
                <p class="slew-hint">@(NexStar.ComsEnabled ? "Click a direction to start slewing. Click ■ to stop." : "Connect to telescope to enable slewing controls.")</p>
            </section>


        <!-- GoTo Panel -->
        <section class="panel goto-panel @(!NexStar.ComsEnabled ? "disabled-panel" : "")">
                <h2>GoTo Coordinates</h2>
                <div class="goto-form">
                    <div class="input-group">
                        <label>RA (hours):</label>
                        <input type="number" step="0.001" min="0" max="24" @bind="_gotoRaHours" placeholder="0.000" disabled="@(!NexStar.ComsEnabled)" />
                    </div>
                    <div class="input-group">
                        <label>Dec (degrees):</label>
                        <input type="number" step="0.01" min="-90" max="90" @bind="_gotoDec" placeholder="0.00" disabled="@(!NexStar.ComsEnabled)" />
                    </div>
                    <div class="button-row">
                        <button class="btn btn-primary" @onclick="ExecuteGoto" disabled="@(_isLoading || !NexStar.ComsEnabled)">
                            🎯 Go To
                        </button>
                        <button class="btn btn-warning" @onclick="CancelGoto" disabled="@(_isLoading || !NexStar.ComsEnabled)">
                            ✕ Cancel
                        </button>
                    </div>
                </div>
            </section>

        <!-- Tracking Mode -->
        <section class="panel tracking-panel @(!NexStar.ComsEnabled ? "disabled-panel" : "")">
                <h2>Tracking</h2>
                <div class="tracking-buttons">
                    @foreach (TrackingMode mode in Enum.GetValues<TrackingMode>())
                    {
                        <button class="btn @(NexStar.CurrentTrackingMode == mode ? "btn-primary" : "btn-secondary")"
                                @onclick="@(() => SetTracking(mode))"
                                disabled="@(_isLoading || !NexStar.ComsEnabled)">
                            @mode
                        </button>
                    }
                </div>
            </section>

        <!-- Settings -->
        <section class="panel settings-panel @(!NexStar.ComsEnabled ? "disabled-panel" : "")">
                <h2>Settings</h2>
                <div class="settings-grid">
                    <div class="setting-item">
                        <h4>Time</h4>
                        @if (_telescopeTime != null)
                        {
                            <p>@_telescopeTime</p>
                        }
                        <button class="btn btn-sm" @onclick="SyncTime" disabled="@(_isLoading || !NexStar.ComsEnabled)">
                            ⏱ Sync with Browser
                        </button>
                    </div>
                    <div class="setting-item">
                        <h4>Location</h4>
                        @if (NexStar.Location != null)
                        {
                            <p>@NexStar.Location.FormatLatitude()</p>
                            <p>@NexStar.Location.FormatLongitude()</p>
                        }
                        <button class="btn btn-sm" @onclick="GetLocation" disabled="@(_isLoading || !NexStar.ComsEnabled)">
                            📍 Get Location
                        </button>
                    </div>
                </div>
            </section>
    </main>
</div>

@code {
    private bool _isLoading = false;
    private string _statusMessage = "";
    private string _statusClass = "";
    private int _slewRate = 5;
    private double _gotoRaHours = 0;
    private double _gotoDec = 0;
    private bool _autoUpdatePosition = false;
    private TelescopeTime? _telescopeTime;
    private System.Timers.Timer? _positionTimer;

    protected override void OnInitialized()
    {
        NexStar.OnStatusChanged += HandleStatusChanged;
        _positionTimer = new System.Timers.Timer(1000);
        _positionTimer.Elapsed += async (s, e) => await AutoUpdatePosition();
    }

    private async Task SelectPort()
    {
        _isLoading = true;
        _statusMessage = "Selecting port...";
        _statusClass = "info";
        StateHasChanged();

        var result = await NexStar.SelectPortAsync();
        if (result)
        {
            _statusMessage = "Port selected. Click Connect to start.";
            _statusClass = "success";
        }
        else
        {
            _statusMessage = "No compatible port selected.";
            _statusClass = "error";
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task DeselectPort()
    {
        _isLoading = true;
        await NexStar.DeselectPortAsync();
        _statusMessage = "";
        _isLoading = false;
        StateHasChanged();
    }

    private async Task Connect()
    {
        _isLoading = true;
        _statusMessage = "Connecting...";
        _statusClass = "info";
        StateHasChanged();

        await NexStar.StartComsAsync();
        
        if (NexStar.ComsEnabled)
        {
            _statusMessage = $"Connected to {NexStar.Model.GetDisplayName()}";
            _statusClass = "success";
            await UpdatePosition();
            await GetTime();
        }
        else
        {
            _statusMessage = "Connection failed.";
            _statusClass = "error";
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task Disconnect()
    {
        _isLoading = true;
        _positionTimer?.Stop();
        await NexStar.StopComsAsync();
        _statusMessage = "Disconnected.";
        _statusClass = "info";
        _isLoading = false;
        StateHasChanged();
    }

    private async Task RefreshInfo()
    {
        _isLoading = true;
        await NexStar.RefreshTelescopeInfoAsync();
        await UpdatePosition();
        _isLoading = false;
        StateHasChanged();
    }

    private async Task UpdatePosition()
    {
        await NexStar.GetRaDecAsync();
        await NexStar.GetAzAltAsync();
        StateHasChanged();
    }

    private async Task AutoUpdatePosition()
    {
        if (_autoUpdatePosition && NexStar.ComsEnabled)
        {
            await UpdatePosition();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SlewNorth()
    {
        var rate = (SlewRate)_slewRate;

        var result = await NexStar.SlewFixedAsync(SlewAxis.DecAlt, SlewDirection.Positive, rate);
        _statusMessage = result ? $"Slewing North at rate {_slewRate}" : "Slew command failed";
        _statusClass = result ? "info" : "error";
        StateHasChanged();
    }

    private async Task SlewSouth()
    {
        var rate = (SlewRate)_slewRate;
        var result = await NexStar.SlewFixedAsync(SlewAxis.DecAlt, SlewDirection.Negative, rate);
        _statusMessage = result ? $"Slewing South at rate {_slewRate}" : "Slew command failed";
        _statusClass = result ? "info" : "error";
        StateHasChanged();
    }

    private async Task SlewEast()
    {
        var rate = (SlewRate)_slewRate;
        var result = await NexStar.SlewFixedAsync(SlewAxis.RaAzm, SlewDirection.Positive, rate);
        _statusMessage = result ? $"Slewing East at rate {_slewRate}" : "Slew command failed";
        _statusClass = result ? "info" : "error";
        StateHasChanged();
    }

    private async Task SlewWest()
    {
        var rate = (SlewRate)_slewRate;
        var result = await NexStar.SlewFixedAsync(SlewAxis.RaAzm, SlewDirection.Negative, rate);
        _statusMessage = result ? $"Slewing West at rate {_slewRate}" : "Slew command failed";
        _statusClass = result ? "info" : "error";
        StateHasChanged();
    }

    private async Task StopAll()
    {
        await NexStar.StopAllSlewAsync();
        await NexStar.CancelGotoAsync();
        _statusMessage = "All motion stopped.";
        _statusClass = "warning";
        StateHasChanged();
    }

    private IEnumerable<CelestialObject> GetQuickTargets()
    {
        // Return some popular objects
        return new List<CelestialObject>
        {
            CelestialCatalogs.AlignmentStars.First(s => s.Name == "Polaris"),
            CelestialCatalogs.Messier.First(m => m.MessierNumber == 31), // Andromeda
            CelestialCatalogs.Messier.First(m => m.MessierNumber == 42), // Orion Nebula
            CelestialCatalogs.Messier.First(m => m.MessierNumber == 45), // Pleiades
            CelestialCatalogs.Messier.First(m => m.MessierNumber == 13), // Hercules Cluster
            CelestialCatalogs.Messier.First(m => m.MessierNumber == 57), // Ring Nebula
        };
    }

    private async Task QuickGoto(CelestialObject target)
    {
        _statusMessage = $"Slewing to {target.DisplayName}...";
        _statusClass = "info";
        StateHasChanged();

        var result = await NexStar.GotoRaDecAsync(target.RightAscension, target.Declination);
        
        if (result)
        {
            _statusMessage = $"GoTo {target.DisplayName} initiated.";
            _statusClass = "success";
        }
        else
        {
            _statusMessage = "GoTo failed.";
            _statusClass = "error";
        }
        StateHasChanged();
    }

    private async Task ExecuteGoto()
    {
        _isLoading = true;
        _statusMessage = "Slewing to target...";
        _statusClass = "info";
        StateHasChanged();

        // Convert RA from hours to degrees
        var raDeg = _gotoRaHours * 15.0;
        var result = await NexStar.GotoRaDecAsync(raDeg, _gotoDec);
        
        if (result)
        {
            _statusMessage = "GoTo command sent.";
            _statusClass = "success";
        }
        else
        {
            _statusMessage = "GoTo failed.";
            _statusClass = "error";
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task CancelGoto()
    {
        await NexStar.CancelGotoAsync();
        _statusMessage = "GoTo cancelled.";
        _statusClass = "warning";
        StateHasChanged();
    }

    private async Task SetTracking(TrackingMode mode)
    {
        _isLoading = true;
        await NexStar.SetTrackingModeAsync(mode);
        _isLoading = false;
        StateHasChanged();
    }

    private async Task GetTime()
    {
        _telescopeTime = await NexStar.GetTimeAsync();
        StateHasChanged();
    }

    private async Task SyncTime()
    {
        _isLoading = true;
        var result = await NexStar.SyncTimeAsync();
        if (result)
        {
            _statusMessage = "Time synced.";
            _statusClass = "success";
            await GetTime();
        }
        else
        {
            _statusMessage = "Time sync failed.";
            _statusClass = "error";
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task GetLocation()
    {
        _isLoading = true;
        await NexStar.GetLocationAsync();
        _isLoading = false;
        StateHasChanged();
    }

    private void HandleStatusChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NexStar.OnStatusChanged -= HandleStatusChanged;
        _positionTimer?.Stop();
        _positionTimer?.Dispose();
    }
}

<style>
    /* ========================================
       Home Page - Night Mode Theme
       Optimized for low-light astronomical viewing
       ======================================== */

    .telescope-app {
        font-family: 'Inter', 'Segoe UI', -apple-system, sans-serif;
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem;
        color: #d4d4d8;
    }

    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.5rem;
        background: linear-gradient(135deg, #0d0d10 0%, #131318 100%);
        border: 1px solid rgba(197, 48, 48, 0.2);
        color: white;
        border-radius: 16px;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .app-header h1 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
        background: linear-gradient(135deg, #fff 0%, #c53030 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .connection-status {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .status {
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .status::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .status.connected { color: #4ade80; }
    .status.connected::before { background: #4ade80; box-shadow: 0 0 10px #4ade80; }
    .status.ready { color: #fbbf24; }
    .status.ready::before { background: #fbbf24; box-shadow: 0 0 10px #fbbf24; }
    .status.disconnected { color: #71717a; }
    .status.disconnected::before { background: #71717a; }

    .model-info {
        color: #71717a;
        font-size: 0.85rem;
    }

    .app-main {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.25rem;
    }

    .panel {
        background: linear-gradient(180deg, #131318 0%, #0f0f12 100%);
        border: 1px solid #27272a;
        border-radius: 16px;
        padding: 1.5rem;
        color: #d4d4d8;
        transition: border-color 0.3s ease;
    }

    .panel:hover {
        border-color: rgba(197, 48, 48, 0.3);
    }

    .panel.disabled-panel {
        opacity: 0.6;
        border-color: #1f1f23;
    }

    .panel.disabled-panel:hover {
        border-color: #1f1f23;
    }

    .panel.disabled-panel h2::after {
        content: ' (Connect to enable)';
        font-size: 0.7rem;
        font-weight: 400;
        color: #52525b;
        margin-left: 0.5rem;
    }

    .disabled-section {
        opacity: 0.5;
    }

    .panel h2 {
        margin: 0 0 1.25rem 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: #e4e4e7;
        border-bottom: 1px solid #27272a;
        padding-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .button-row {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn {
        padding: 0.75rem 1.25rem;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .btn-primary { 
        background: linear-gradient(135deg, #c53030 0%, #9b2c2c 100%);
        color: white;
        box-shadow: 0 2px 10px rgba(197, 48, 48, 0.3);
    }
    .btn-primary:hover:not(:disabled) { 
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        transform: translateY(-1px);
    }
    
    .btn-success { 
        background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
        color: white; 
    }
    .btn-success:hover:not(:disabled) { 
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
    }
    
    .btn-danger { 
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        color: white;
    }
    .btn-danger:hover:not(:disabled) { 
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    }
    
    .btn-warning { 
        background: linear-gradient(135deg, #ca8a04 0%, #a16207 100%);
        color: white; 
    }
    .btn-warning:hover:not(:disabled) { 
        background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
    }
    
    .btn-secondary { 
        background: #27272a;
        color: #a1a1aa;
        border: 1px solid #3f3f46;
    }
    .btn-secondary:hover:not(:disabled) { 
        background: #3f3f46;
        color: #d4d4d8;
    }

    .btn-sm {
        padding: 0.5rem 1rem;
        font-size: 0.8rem;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin-top: 1rem;
    }

    .info-item label {
        display: block;
        color: #71717a;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
    }

    .status-good { color: #4ade80; }
    .status-warn { color: #fbbf24; }

    .status-message {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 10px;
        font-size: 0.9rem;
        border-left: 3px solid;
    }

    .status-message.info { 
        background: rgba(37, 99, 235, 0.15);
        border-left-color: #3b82f6;
    }
    .status-message.success { 
        background: rgba(22, 163, 74, 0.15);
        border-left-color: #22c55e;
    }
    .status-message.error { 
        background: rgba(220, 38, 38, 0.15);
        border-left-color: #dc2626;
    }
    .status-message.warning { 
        background: rgba(202, 138, 4, 0.15);
        border-left-color: #eab308;
    }

    .position-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .position-card {
        background: #0a0a0c;
        padding: 1rem;
        border-radius: 12px;
        border: 1px solid #1f1f23;
    }

    .position-card h3 {
        margin: 0 0 0.75rem 0;
        font-size: 0.85rem;
        font-weight: 500;
        color: #71717a;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .coord-row {
        display: flex;
        justify-content: space-between;
        padding: 0.35rem 0;
    }

    .coord-row label {
        color: #52525b;
    }

    .coord-value {
        font-family: 'JetBrains Mono', 'Consolas', monospace;
        color: #c53030;
        font-weight: 500;
    }

    .no-data {
        color: #52525b;
        font-style: italic;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #71717a;
        cursor: pointer;
        font-size: 0.9rem;
    }

    .checkbox-label input[type="checkbox"] {
