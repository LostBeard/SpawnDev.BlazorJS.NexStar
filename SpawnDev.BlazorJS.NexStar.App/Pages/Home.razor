@page "/"
@inject NexStarService NexStar
@inject BlazorJSRuntime JS
@implements IDisposable

<PageTitle>NexStar Telescope Control</PageTitle>

<div class="telescope-app">
    <!-- Header -->
    <header class="app-header">
        <h1>🔭 NexStar Telescope Control</h1>
        <div class="connection-status">
            @if (NexStar.ComsEnabled)
            {
                <span class="status connected">● Connected</span>
                <span class="model-info">@NexStar.Model.GetDisplayName() @NexStar.Version</span>
            }
            else if (NexStar.SerialPortSelected)
            {
                <span class="status ready">○ Ready</span>
            }
            else
            {
                <span class="status disconnected">○ Disconnected</span>
            }
        </div>
    </header>

    <main class="app-main">
        <!-- Connection Panel -->
        <section class="panel connection-panel">
            <h2>Connection</h2>
            <div class="button-row">
                @if (!NexStar.SerialPortSelected)
                {
                    <button class="btn btn-primary" @onclick="SelectPort" disabled="@_isLoading">
                        <span class="icon">🔌</span> Select Port
                    </button>
                }
                else if (!NexStar.ComsEnabled)
                {
                    <button class="btn btn-success" @onclick="Connect" disabled="@_isLoading">
                        <span class="icon">▶</span> Connect
                    </button>
                    <button class="btn btn-secondary" @onclick="DeselectPort" disabled="@_isLoading">
                        <span class="icon">✕</span> Change Port
                    </button>
                }
                else
                {
                    <button class="btn btn-danger" @onclick="Disconnect" disabled="@_isLoading">
                        <span class="icon">■</span> Disconnect
                    </button>
                    <button class="btn btn-secondary" @onclick="RefreshInfo" disabled="@_isLoading">
                        <span class="icon">↻</span> Refresh
                    </button>
                }
            </div>
            @if (NexStar.ComsEnabled)
            {
                <div class="info-grid">
                    <div class="info-item">
                        <label>Alignment</label>
                        <span class="@(NexStar.IsAligned ? "status-good" : "status-warn")">
                            @(NexStar.IsAligned ? "✓ Aligned" : "⚠ Not Aligned")
                        </span>
                    </div>
                    <div class="info-item">
                        <label>Tracking</label>
                        <span>@NexStar.CurrentTrackingMode</span>
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <div class="status-message @_statusClass">@_statusMessage</div>
            }
        </section>

        @if (NexStar.ComsEnabled)
        {
            <!-- Position Display -->
            <section class="panel position-panel">
                <h2>Position</h2>
                <div class="position-grid">
                    <div class="position-card">
                        <h3>Equatorial (RA/Dec)</h3>
                        @if (NexStar.CurrentRaDec != null)
                        {
                            <div class="coord-row">
                                <label>RA:</label>
                                <span class="coord-value">@NexStar.CurrentRaDec.FormatRA()</span>
                            </div>
                            <div class="coord-row">
                                <label>Dec:</label>
                                <span class="coord-value">@NexStar.CurrentRaDec.FormatDec()</span>
                            </div>
                        }
                        else
                        {
                            <p class="no-data">No data</p>
                        }
                    </div>
                    <div class="position-card">
                        <h3>Horizontal (Az/Alt)</h3>
                        @if (NexStar.CurrentAzAlt != null)
                        {
                            <div class="coord-row">
                                <label>Az:</label>
                                <span class="coord-value">@NexStar.CurrentAzAlt.FormatAz()</span>
                            </div>
                            <div class="coord-row">
                                <label>Alt:</label>
                                <span class="coord-value">@NexStar.CurrentAzAlt.FormatAlt()</span>
                            </div>
                        }
                        else
                        {
                            <p class="no-data">No data</p>
                        }
                    </div>
                </div>
                <div class="button-row">
                    <button class="btn btn-sm" @onclick="UpdatePosition" disabled="@_isLoading">
                        ↻ Update Position
                    </button>
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="_autoUpdatePosition" />
                        Auto-update
                    </label>
                </div>
            </section>

            <!-- Manual Slew Controls -->
            <section class="panel slew-panel">
                <h2>Manual Slew</h2>
                <div class="slew-controls">
                    <div class="dpad">
                        <button type="button" class="dpad-btn north" 
                                @onclick="@(async () => await SlewNorth())">
                            ▲<br/>N
                        </button>
                        <button type="button" class="dpad-btn west"
                                @onclick="@(async () => await SlewWest())">
                            ◀ W
                        </button>
                        <button type="button" class="dpad-btn stop" @onclick="StopAll">■</button>
                        <button type="button" class="dpad-btn east"
                                @onclick="@(async () => await SlewEast())">
                            E ▶
                        </button>
                        <button type="button" class="dpad-btn south"
                                @onclick="@(async () => await SlewSouth())">
                            S<br/>▼
                        </button>
                    </div>
                    <div class="slew-rate-control">
                        <label>Slew Rate: @_slewRate</label>
                        <input type="range" min="1" max="9" @bind="_slewRate" @bind:event="oninput" />
                        <div class="rate-labels">
                            <span>Slow</span>
                            <span>Fast</span>
                        </div>
                    </div>
                </div>
                <p class="slew-hint">Click a direction to start slewing. Click ■ to stop.</p>
            </section>


            <!-- GoTo Panel -->
            <section class="panel goto-panel">
                <h2>GoTo Coordinates</h2>
                <div class="goto-form">
                    <div class="input-group">
                        <label>RA (hours):</label>
                        <input type="number" step="0.001" min="0" max="24" @bind="_gotoRaHours" placeholder="0.000" />
                    </div>
                    <div class="input-group">
                        <label>Dec (degrees):</label>
                        <input type="number" step="0.01" min="-90" max="90" @bind="_gotoDec" placeholder="0.00" />
                    </div>
                    <div class="button-row">
                        <button class="btn btn-primary" @onclick="ExecuteGoto" disabled="@_isLoading">
                            🎯 Go To
                        </button>
                        <button class="btn btn-warning" @onclick="CancelGoto" disabled="@_isLoading">
                            ✕ Cancel
                        </button>
                    </div>
                </div>
            </section>

            <!-- Tracking Mode -->
            <section class="panel tracking-panel">
                <h2>Tracking</h2>
                <div class="tracking-buttons">
                    @foreach (TrackingMode mode in Enum.GetValues<TrackingMode>())
                    {
                        <button class="btn @(NexStar.CurrentTrackingMode == mode ? "btn-primary" : "btn-secondary")"
                                @onclick="@(() => SetTracking(mode))"
                                disabled="@_isLoading">
                            @mode
                        </button>
                    }
                </div>
            </section>

            <!-- Settings -->
            <section class="panel settings-panel">
                <h2>Settings</h2>
                <div class="settings-grid">
                    <div class="setting-item">
                        <h4>Time</h4>
                        @if (_telescopeTime != null)
                        {
                            <p>@_telescopeTime</p>
                        }
                        <button class="btn btn-sm" @onclick="SyncTime" disabled="@_isLoading">
                            ⏱ Sync with Browser
                        </button>
                    </div>
                    <div class="setting-item">
                        <h4>Location</h4>
                        @if (NexStar.Location != null)
                        {
                            <p>@NexStar.Location.FormatLatitude()</p>
                            <p>@NexStar.Location.FormatLongitude()</p>
                        }
                        <button class="btn btn-sm" @onclick="GetLocation" disabled="@_isLoading">
                            📍 Get Location
                        </button>
                    </div>
                </div>
            </section>
        }
    </main>
</div>

@code {
    private bool _isLoading = false;
    private string _statusMessage = "";
    private string _statusClass = "";
    private int _slewRate = 5;
    private double _gotoRaHours = 0;
    private double _gotoDec = 0;
    private bool _autoUpdatePosition = false;
    private TelescopeTime? _telescopeTime;
    private System.Timers.Timer? _positionTimer;

    protected override void OnInitialized()
    {
        NexStar.OnStatusChanged += HandleStatusChanged;
        _positionTimer = new System.Timers.Timer(1000);
        _positionTimer.Elapsed += async (s, e) => await AutoUpdatePosition();
    }

    private async Task SelectPort()
    {
        _isLoading = true;
        _statusMessage = "Selecting port...";
        _statusClass = "info";
        StateHasChanged();

        var result = await NexStar.SelectPortAsync();
        if (result)
        {
            _statusMessage = "Port selected. Click Connect to start.";
            _statusClass = "success";
        }
        else
        {
            _statusMessage = "No compatible port selected.";
            _statusClass = "error";
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task DeselectPort()
    {
        _isLoading = true;
        await NexStar.DeselectPortAsync();
        _statusMessage = "";
        _isLoading = false;
        StateHasChanged();
    }

    private async Task Connect()
    {
        _isLoading = true;
        _statusMessage = "Connecting...";
        _statusClass = "info";
        StateHasChanged();

        await NexStar.StartComsAsync();
        
        if (NexStar.ComsEnabled)
        {
            _statusMessage = $"Connected to {NexStar.Model.GetDisplayName()}";
            _statusClass = "success";
            await UpdatePosition();
            await GetTime();
        }
        else
        {
            _statusMessage = "Connection failed.";
            _statusClass = "error";
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task Disconnect()
    {
        _isLoading = true;
        _positionTimer?.Stop();
        await NexStar.StopComsAsync();
        _statusMessage = "Disconnected.";
        _statusClass = "info";
        _isLoading = false;
        StateHasChanged();
    }

    private async Task RefreshInfo()
    {
        _isLoading = true;
        await NexStar.RefreshTelescopeInfoAsync();
        await UpdatePosition();
        _isLoading = false;
        StateHasChanged();
    }

    private async Task UpdatePosition()
    {
        await NexStar.GetRaDecAsync();
        await NexStar.GetAzAltAsync();
        StateHasChanged();
    }

    private async Task AutoUpdatePosition()
    {
        if (_autoUpdatePosition && NexStar.ComsEnabled)
        {
            await UpdatePosition();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SlewNorth()
    {
        var rate = (SlewRate)_slewRate;

        var result = await NexStar.SlewFixedAsync(SlewAxis.DecAlt, SlewDirection.Positive, rate);
        _statusMessage = result ? $"Slewing North at rate {_slewRate}" : "Slew command failed";
        _statusClass = result ? "info" : "error";
        StateHasChanged();
    }

    private async Task SlewSouth()
    {
        var rate = (SlewRate)_slewRate;
        var result = await NexStar.SlewFixedAsync(SlewAxis.DecAlt, SlewDirection.Negative, rate);
        _statusMessage = result ? $"Slewing South at rate {_slewRate}" : "Slew command failed";
        _statusClass = result ? "info" : "error";
        StateHasChanged();
    }

    private async Task SlewEast()
    {
        var rate = (SlewRate)_slewRate;
        var result = await NexStar.SlewFixedAsync(SlewAxis.RaAzm, SlewDirection.Positive, rate);
        _statusMessage = result ? $"Slewing East at rate {_slewRate}" : "Slew command failed";
        _statusClass = result ? "info" : "error";
        StateHasChanged();
    }

    private async Task SlewWest()
    {
        var rate = (SlewRate)_slewRate;
        var result = await NexStar.SlewFixedAsync(SlewAxis.RaAzm, SlewDirection.Negative, rate);
        _statusMessage = result ? $"Slewing West at rate {_slewRate}" : "Slew command failed";
        _statusClass = result ? "info" : "error";
        StateHasChanged();
    }

    private async Task StopAll()
    {
        await NexStar.StopAllSlewAsync();
        await NexStar.CancelGotoAsync();
        _statusMessage = "All motion stopped.";
        _statusClass = "warning";
        StateHasChanged();
    }


    private async Task ExecuteGoto()
    {
        _isLoading = true;
        _statusMessage = "Slewing to target...";
        _statusClass = "info";
        StateHasChanged();

        // Convert RA from hours to degrees
        var raDeg = _gotoRaHours * 15.0;
        var result = await NexStar.GotoRaDecAsync(raDeg, _gotoDec);
        
        if (result)
        {
            _statusMessage = "GoTo command sent.";
            _statusClass = "success";
        }
        else
        {
            _statusMessage = "GoTo failed.";
            _statusClass = "error";
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task CancelGoto()
    {
        await NexStar.CancelGotoAsync();
        _statusMessage = "GoTo cancelled.";
        _statusClass = "warning";
        StateHasChanged();
    }

    private async Task SetTracking(TrackingMode mode)
    {
        _isLoading = true;
        await NexStar.SetTrackingModeAsync(mode);
        _isLoading = false;
        StateHasChanged();
    }

    private async Task GetTime()
    {
        _telescopeTime = await NexStar.GetTimeAsync();
        StateHasChanged();
    }

    private async Task SyncTime()
    {
        _isLoading = true;
        var result = await NexStar.SyncTimeAsync();
        if (result)
        {
            _statusMessage = "Time synced.";
            _statusClass = "success";
            await GetTime();
        }
        else
        {
            _statusMessage = "Time sync failed.";
            _statusClass = "error";
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task GetLocation()
    {
        _isLoading = true;
        await NexStar.GetLocationAsync();
        _isLoading = false;
        StateHasChanged();
    }

    private void HandleStatusChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NexStar.OnStatusChanged -= HandleStatusChanged;
        _positionTimer?.Stop();
        _positionTimer?.Dispose();
    }
}

<style>
    .telescope-app {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem;
    }

    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        color: white;
        border-radius: 12px;
        margin-bottom: 1rem;
    }

    .app-header h1 {
        margin: 0;
        font-size: 1.5rem;
    }

    .connection-status {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .status {
        font-weight: bold;
    }

    .status.connected { color: #4ade80; }
    .status.ready { color: #facc15; }
    .status.disconnected { color: #94a3b8; }

    .model-info {
        color: #94a3b8;
        font-size: 0.9rem;
    }

    .app-main {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
    }

    .panel {
        background: #1e293b;
        border-radius: 12px;
        padding: 1.5rem;
        color: white;
    }

    .panel h2 {
        margin: 0 0 1rem 0;
        font-size: 1.2rem;
        color: #e2e8f0;
        border-bottom: 1px solid #334155;
        padding-bottom: 0.5rem;
    }

    .button-row {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .btn {
        padding: 0.75rem 1.25rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-primary { background: #3b82f6; color: white; }
    .btn-primary:hover:not(:disabled) { background: #2563eb; }
    
    .btn-success { background: #22c55e; color: white; }
    .btn-success:hover:not(:disabled) { background: #16a34a; }
    
    .btn-danger { background: #ef4444; color: white; }
    .btn-danger:hover:not(:disabled) { background: #dc2626; }
    
    .btn-warning { background: #f59e0b; color: white; }
    .btn-warning:hover:not(:disabled) { background: #d97706; }
    
    .btn-secondary { background: #475569; color: white; }
    .btn-secondary:hover:not(:disabled) { background: #64748b; }

    .btn-sm {
        padding: 0.5rem 1rem;
        font-size: 0.8rem;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin-top: 1rem;
    }

    .info-item label {
        display: block;
        color: #94a3b8;
        font-size: 0.8rem;
        margin-bottom: 0.25rem;
    }

    .status-good { color: #4ade80; }
    .status-warn { color: #facc15; }

    .status-message {
        margin-top: 1rem;
        padding: 0.75rem;
        border-radius: 8px;
        font-size: 0.9rem;
    }

    .status-message.info { background: #1e40af; }
    .status-message.success { background: #166534; }
    .status-message.error { background: #991b1b; }
    .status-message.warning { background: #854d0e; }

    .position-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .position-card {
        background: #0f172a;
        padding: 1rem;
        border-radius: 8px;
    }

    .position-card h3 {
        margin: 0 0 0.5rem 0;
        font-size: 0.9rem;
        color: #94a3b8;
    }

    .coord-row {
        display: flex;
        justify-content: space-between;
        padding: 0.25rem 0;
    }

    .coord-row label {
        color: #64748b;
    }

    .coord-value {
        font-family: 'Consolas', monospace;
        color: #4ade80;
    }

    .no-data {
        color: #64748b;
        font-style: italic;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #94a3b8;
        cursor: pointer;
    }

    .slew-controls {
        display: flex;
        gap: 2rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .dpad {
        display: grid;
        grid-template-areas:
            ". north ."
            "west stop east"
            ". south .";
        grid-template-columns: repeat(3, 60px);
        grid-template-rows: repeat(3, 60px);
        gap: 4px;
    }

    .dpad-btn {
        background: #334155;
        border: none;
        border-radius: 8px;
        color: white;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.1s;
    }

    .dpad-btn:hover { background: #475569; }
    .dpad-btn:active { background: #3b82f6; transform: scale(0.95); }

    .dpad-btn.north { grid-area: north; }
    .dpad-btn.south { grid-area: south; }
    .dpad-btn.east { grid-area: east; }
    .dpad-btn.west { grid-area: west; }
    .dpad-btn.stop { grid-area: stop; background: #dc2626; }
    .dpad-btn.stop:hover { background: #ef4444; }

    .slew-rate-control {
        flex: 1;
        min-width: 150px;
    }

    .slew-rate-control label {
        display: block;
        margin-bottom: 0.5rem;
        color: #94a3b8;
    }

    .slew-rate-control input[type="range"] {
        width: 100%;
        accent-color: #3b82f6;
    }

    .rate-labels {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        color: #64748b;
    }

    .slew-hint {
        margin-top: 1rem;
        color: #64748b;
        font-size: 0.85rem;
        text-align: center;
    }

    .goto-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .input-group label {
        color: #94a3b8;
        font-size: 0.9rem;
    }

    .input-group input {
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 0.75rem;
        color: white;
        font-size: 1rem;
    }

    .input-group input:focus {
        outline: none;
        border-color: #3b82f6;
    }

    .tracking-buttons {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .settings-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .setting-item {
        background: #0f172a;
        padding: 1rem;
        border-radius: 8px;
    }

    .setting-item h4 {
        margin: 0 0 0.5rem 0;
        color: #94a3b8;
    }

    .setting-item p {
        margin: 0.25rem 0;
        font-family: 'Consolas', monospace;
        font-size: 0.9rem;
    }

    @@media (max-width: 768px) {
        .app-header {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }

        .position-grid,
        .settings-grid {
            grid-template-columns: 1fr;
        }

        .slew-controls {
            flex-direction: column;
        }
    }
</style>
